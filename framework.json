 "lenses": [
  {
   "order": 1,
   "key": "father",
   "lens": "Father figure",
   "kind": "Inherited",
   "questions": "What do you believe your father figure holds as true about this? What explicit and implicit messages led you to that conclusion? Where do you think their belief came from?",
   "alt": "If a father figure was absent, unknown or painful, explore another caregiver or early influence instead, or skip this lens."
  },
  {
   "order": 2,
   "key": "mother",
   "lens": "Mother figure",
   "kind": "Inherited",
   "questions": "What do you believe your mother figure holds as true about this? What explicit and implicit messages led you to that conclusion? Where do you think their belief came from?",
   "alt": "If a mother figure was absent, unknown or painful, explore another caregiver or early influence instead, or skip this lens."
  },
  {
   "order": 3,
   "key": "admired",
   "lens": "Admired figure",
   "kind": "Inherited",
   "questions": "What do you believe someone you admire holds as true about this? What explicit and implicit messages led you to that conclusion? Where do you think their belief came from?",
   "alt": ""
  },
  {
   "order": 4,
   "key": "society",
   "lens": "Society",
   "kind": "Inherited",
   "questions": "What does general society hold as true about this? What messages tell you so? Where does that belief come from?",
   "alt": ""
  },
  {
   "order": 5,
   "key": "own",
   "lens": "My own",
   "kind": "Own",
   "questions": "What do I hold as true about this?",
   "alt": ""
  },
  {
   "order": 6,
   "key": "vis",
   "lens": "Me vis-à-vis others",
   "kind": "Own",
   "questions": "What am I carrying forward from my father, mother, admired figure and society? How well does this belief serve me in becoming the grandest version of myself I can imagine? Is there a belief that could expand my possibilities beyond what I believe now?",
   "alt": ""
  },
  {
   "order": 7,
   "key": "truth",
   "lens": "Belief vs. verifiable truth",
   "kind": "Own",
   "questions": "What here is truth and what is belief? Why do I choose to believe it, and what is really motivating that choice?",
   "alt": ""
  }
 ],

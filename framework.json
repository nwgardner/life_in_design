{
 "version": "1.0",
 "elements": [
  {
   "order": 1,
   "layer": "Why",
   "element": "Core Beliefs",
   "oneLine": "The beliefs you accept as true about yourself, others and the cosmos",
   "definingQuestion": "What do I choose to believe is fundamentally true about myself, others and the universe?",
   "strongDraft": "3–7 short statements covering self, others and the universe, each one the person would act on."
  },
  {
   "order": 2,
   "layer": "Why",
   "element": "Vision",
   "oneLine": "A future state you envision for you and others",
   "definingQuestion": "What is the grandest possible future, emerging from my beliefs, that I can see for me and others?",
   "strongDraft": "A vivid, energizing picture that includes other people, not only the self, and that clearly grows out of the Core Beliefs."
  },
  {
   "order": 3,
   "layer": "Why",
   "element": "Purpose",
   "oneLine": "Your role in bringing about the vision you see",
   "definingQuestion": "What is my central role in bringing about my Vision of the future?",
   "strongDraft": "One or two sentences naming the person's distinct role in the Vision. Memorable enough to recall in a hard moment."
  },
  {
   "order": 4,
   "layer": "How",
   "element": "Governing Principles",
   "oneLine": "The fundamental ethos that governs and motivates your attitudes and actions",
   "definingQuestion": "What governing principles naturally emerge as necessarily connected to my Core Beliefs, Vision and Purpose?",
   "strongDraft": "3–7 principles phrased as usable decision rules, each traceable to the Why."
  },
  {
   "order": 5,
   "layer": "How",
   "element": "Strategy",
   "oneLine": "Your action plan, aligning vision and purpose with time, energy and resources",
   "definingQuestion": "With finite time and finite resources, what trade-offs (say yes, say no) will I make to accomplish my Purpose?",
   "strongDraft": "A short list of focus areas and goals for a defined period, plus an explicit list of what the person is saying no to."
  },
  {
   "order": 6,
   "layer": "How",
   "element": "Relationships",
   "oneLine": "The people you choose to work with to achieve your purpose",
   "definingQuestion": "Who will I walk with to enrich my Purpose and bring about my Vision?",
   "strongDraft": "Named people or groups in roles (multipliers, complements, fellow travelers), plus energizing and draining influences to adjust."
  },
  {
   "order": 7,
   "layer": "What",
   "element": "Key Activities",
   "oneLine": "Your priorities, daily habits and where you spend your time",
   "definingQuestion": "How will I spend my time to accomplish my Purpose, and what activities will I say no to?",
   "strongDraft": "A realistic picture of a typical week, with specific activities added and removed to match the Strategy."
  },
  {
   "order": 8,
   "layer": "What",
   "element": "Resources",
   "oneLine": "Your strengths: what you are good at and passionate about",
   "definingQuestion": "What strengths, tools, resources and advantages are at my disposal to help me achieve my Purpose?",
   "strongDraft": "An honest inventory of strengths, skills, assets and access, each linked to where it serves the Strategy."
  },
  {
   "order": 9,
   "layer": "What",
   "element": "Methods",
   "oneLine": "The style, habits, systems and processes that govern your actions",
   "definingQuestion": "What systems, tools and metrics do I use to achieve and measure progress toward my Purpose?",
   "strongDraft": "A few habits or routines, one to three measures of progress, and the mindset practices that keep the person on course."
  }
 ],
